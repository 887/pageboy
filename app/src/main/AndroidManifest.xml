<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Setup wizard "scan all files" path uses READ_EXTERNAL_STORAGE
      (simple runtime permission dialog, same pattern as tonearmboy's
      READ_MEDIA_AUDIO). On Android 13+ this permission is a no-op for
      non-media files, but the FileSystemScanner can still walk
      Documents/Download/Books via java.io.File because those are
      shared-storage directories accessible to all apps.
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".PageboyApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.Pageboy">

        <activity
            android:name=".PageboyActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|locale|layoutDirection|density|uiMode">

            <!-- Launcher intent. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              main.md A.6 — deep-link intent filters so pageboy is a
              first-class "Open with…" target from file managers, email,
              browsers, and share-sheets. Phase N hooks the reader to
              these; for Phase A we just declare them so the share-sheet
              already lists pageboy.

              Each filter declares both content:// and file:// schemes
              alongside the MIME type — modern Android share intents
              flow through content://, but some file managers still send
              file:// URIs.
            -->

            <!-- Markdown (text/markdown, text/x-markdown) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="text/markdown" />
                <data android:scheme="content" />
                <data android:scheme="file" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="text/x-markdown" />
                <data android:scheme="content" />
                <data android:scheme="file" />
            </intent-filter>
            <!-- Path-pattern fallback for file managers that hand us a
                 generic text/plain intent on a .md / .markdown file. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.md" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.markdown" />
            </intent-filter>

            <!-- PDF -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/pdf" />
                <data android:scheme="content" />
                <data android:scheme="file" />
            </intent-filter>

            <!-- EPUB -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/epub+zip" />
                <data android:scheme="content" />
                <data android:scheme="file" />
            </intent-filter>

            <!-- Plain text -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="text/plain" />
                <data android:scheme="content" />
                <data android:scheme="file" />
            </intent-filter>

            <!-- DOCX (Microsoft Word OOXML) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:scheme="content" />
                <data android:scheme="file" />
            </intent-filter>

            <!-- XLSX (Microsoft Excel OOXML) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:scheme="content" />
                <data android:scheme="file" />
            </intent-filter>

            <!-- ODT (OpenDocument Text) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
                <data android:scheme="content" />
                <data android:scheme="file" />
            </intent-filter>

            <!-- ODS (OpenDocument Spreadsheet) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/vnd.oasis.opendocument.spreadsheet" />
                <data android:scheme="content" />
                <data android:scheme="file" />
            </intent-filter>

            <!-- Phase Q — MOBI (Mobipocket canonical) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/x-mobipocket-ebook" />
                <data android:scheme="content" />
                <data android:scheme="file" />
            </intent-filter>

            <!-- Phase Q — AZW / KF8 / AZW3 (Amazon canonical) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/vnd.amazon.ebook" />
                <data android:scheme="content" />
                <data android:scheme="file" />
            </intent-filter>

            <!-- Phase Q — MOBI / AZW family path-pattern catch-alls for
                 senders that emit application/octet-stream (the common
                 case for file managers handling .mobi/.azw/.azw3/.prc). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathPattern=".*\\.mobi" />
                <data android:pathPattern=".*\\.azw" />
                <data android:pathPattern=".*\\.azw3" />
                <data android:pathPattern=".*\\.prc" />
            </intent-filter>
        </activity>
        <!-- Phase N — open-with activity. Exported + intent-filter-only
             (no launcher entry). Routes ACTION_VIEW intents from file
             managers / share sheets into the reader via OpenWithResolver. -->
        <activity
            android:name=".openwith.OpenWithActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">

            <!-- Catch-all for application/octet-stream + path patterns -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- application/zip catch-all (EPUB / DOCX / XLSX / ODT / ODS
                 are all zip-based; some file managers send application/zip
                 instead of the canonical MIME). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:mimeType="application/zip" />
            </intent-filter>
        </activity>
    </application>

</manifest>
