<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      API 31+ variant of res/values/themes.xml: adds the platform splash-screen
      icon (`windowSplashScreenAnimatedIcon` only exists from API 31).
    -->
    <style name="Theme.Pageboy" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>
