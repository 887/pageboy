<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Splash + post-splash theme. Cold-boot intentionally always reads
      dark (windowBackground = splash_background = #0F0A08) to avoid a
      white flash when the system theme is light — same pattern as
      tonearmboy D.17.2. Compose's MaterialExpressiveTheme owns
      runtime colours; the Android theme is only the bootstrap surface.
    -->
    <style name="Theme.Pageboy" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>
