<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Base theme is the OS Material light NoActionBar — Compose's
      MaterialExpressiveTheme owns runtime colours / typography. The
      Android theme is only the bootstrap surface the window opens
      onto.
    -->
    <style name="Theme.Pageboy" parent="android:Theme.Material.Light.NoActionBar" />

    <!--
      Phase N.2 — translucent splash theme for OpenWithActivity. The
      activity has no visible surface of its own — it resolves the
      incoming intent on the IO dispatcher, launches PageboyActivity
      with the resolved documentId, and finishes. The translucent
      window prevents a flash of solid chrome between the chooser and
      the reader.
    -->
    <style name="Theme.Pageboy.OpenWith" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation</item>
    </style>
</resources>
